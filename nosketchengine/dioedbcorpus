NAME "dioedbcorpus"
PATH "/var/lib/manatee/data/dioedbcorpus"
VERTICAL "| ls /var/lib/manatee/verticals/dioedb-corpus-data/*.vert | xargs cat"
MAINTAINER "Jakob.Bal@oeaw.ac.at"
LANGUAGE "German"
ENCODING "utf-8"

# --- POSITIONAL ATTRIBUTES (Columns) ---
ATTRIBUTE word
ATTRIBUTE lemma
ATTRIBUTE pos
ATTRIBUTE feats
ATTRIBUTE tm_start
ATTRIBUTE tm_end

ATTRIBUTE lc {
    LABEL "word (lowercase)"
    DYNAMIC utf8lowercase
    DYNLIB internal
    ARG1 "C"
    FUNTYPE s
    FROMATTR word
    TYPE index
    TRANSQUERY yes
}

# --- STRUCTURES (Hierarchical Tags) ---
STRUCTURE doc {
    ATTRIBUTE id
    ATTRIBUTE title
    ATTRIBUTE erhebung
    ATTRIBUTE erhebungsart
    ATTRIBUTE name
}
STRUCTURE file {
    ATTRIBUTE id
    ATTRIBUTE title
}
# Updated Utterance Structure
STRUCTURE u {
    ATTRIBUTE who
    ATTRIBUTE sex
    ATTRIBUTE age
    ATTRIBUTE name
    ATTRIBUTE start
    ATTRIBUTE subproject
    ATTRIBUTE dialect_competence
    ATTRIBUTE standard_competence
    ATTRIBUTE end
    ATTRIBUTE location
    ATTRIBUTE lat
    ATTRIBUTE lon
    ATTRIBUTE age_lower
    ATTRIBUTE age_upper
}
STRUCTURE pause {
    ATTRIBUTE duration
}

